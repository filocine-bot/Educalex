# Copie este archivo como .env para trabajar en su computador,
# y registre las mismas variables en Vercel (Settings → Environment Variables).

# Supabase (supabase.com → su proyecto → Project Settings → API)
VITE_SUPABASE_URL=https://SU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_URL=https://SU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Docente IA (console.anthropic.com → API Keys). Solo en el servidor; nunca con prefijo VITE_.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Opcional: modelo de Claude. Por defecto claude-sonnet-5-5 (más económico: claude-haiku-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5
